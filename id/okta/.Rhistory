import inflect
from datetime import date
from datetime import datetime
import sys
p = inflect.engine()
def main():
print(convert(input("Birth Date: ")))
def convert(s):
try:
today = date.today()
today_midnight = datetime.combine(today, datetime.min.time()) #force midnight timestamp so the math works correctly
#print(today_midnight)
#today = date.fromisoformat("2000-01-01")
birth_date = date.fromisoformat(s)
birth_date_midnight = datetime.combine(birth_date, datetime.min.time())
#print(birth_date_midnight)
delta = today_midnight - birth_date_midnight
days = delta.days
minutes = days * 24 * 60
words = p.number_to_words(minutes, andword="") #use inflect to convert numbers to words
caps = words.capitalize() + " minutes" #force the first letter to a capital and force the 'minutes' onto the end
return caps
except:
sys.exit(1)
if __name__ == "__main__":
main()
12-22-1978
12-22-1978
December 22, 1978
quit()
exit()
