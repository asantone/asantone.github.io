#load data
library(datarium)
library(PerformanceAnalytics)
library(mctest)
library(lmtest)
library(car)
library(forecast)
data(marketing)
df<-marketing
#MMM model using multiple regression with the adstocked values for Youtube, Facebook and Newspaper
#set adstock rates & memory values
#Applying Gabriel Mohanna's maximum period decay method
adstocks<-c(0.1,0.15,0.25)
memory<-2
adstock_youtube   <- rep(adstocks[1], memory+1) ^ c(0:memory)
adstock_facebook  <- rep(adstocks[2], memory+1) ^ c(0:memory)
adstock_news      <- rep(adstocks[3], memory+1) ^ c(0:memory)
#Adstock visualizations
#adstocked facebook
ads_fb <- stats::filter(c(rep(0, memory), df$facebook), adstock_facebook, method="convolution")
ads_fb <- ads_fb[!is.na(ads_fb)]
#plot
plot(seq(1,length(df$facebook)), df$facebook, type="h",
main = "Adstocked Facebook",
xlab="Time (Weeks)", ylab="Facebook",
ylim=c(0, max(c(df$facebook, ads_fb))),
frame.plot=FALSE)
lines(ads_fb, col="blue")
#adstocked youtube
ads_yt <- stats::filter(c(rep(0, memory), df$youtube), adstock_youtube, method="convolution")
ads_yt <- ads_yt[!is.na(ads_yt)]
#plot
plot(seq(1,length(df$youtube)), df$youtube, type="h",
main = "Adstocked Youtube",
xlab="Time (Weeks)", ylab="youtube",
ylim=c(0, max(c(df$youtube, ads_yt))),
frame.plot=FALSE)
lines(ads_yt, col="blue")
#adstocked news
ads_news <- stats::filter(c(rep(0, memory), df$news), adstock_news, method="convolution")
ads_news <- ads_news[!is.na(ads_news)]
#plot
plot(seq(1,length(df$news)), df$news, type="h",
main = "Adstocked News",
xlab="Time (Weeks)", ylab="News",
ylim=c(0, max(c(df$news, ads_news))),
frame.plot=FALSE)
lines(ads_news, col="blue")
head(ads_news)
news_spend <- as.data.frame(ads_news)
names(news_spend)[1] <- "ads_news"
head(news_spend)
